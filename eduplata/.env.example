# ANTHROPIC_API_KEY: clave de Claude para el asistente dentro de la app (opcional).
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# Supabase: base de datos compartida con el conector MCP de Claude (tabla eduplata_user_state + Supabase Auth).
# Si se dejan vacías, se guarda en data/eduplata_database.json con un único usuario local y sin login (solo desarrollo).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# MCP_PUBLIC_URL: URL del conector en Horizon; con ella se arma el link personal de cada estudiante.
MCP_PUBLIC_URL="https://eduplata.fastmcp.app/mcp"

PORT=3000
