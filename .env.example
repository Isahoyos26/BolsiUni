# ANTHROPIC_API_KEY: Clave secreta para la API de Claude (Anthropic).
# Se usa exclusivamente desde el backend en server.ts para el asistente de registro rápido.
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# Supabase: base de datos compartida entre la app web y el conector MCP de Claude.
# Si se dejan vacías, la app guarda en data/moai_database.json (solo útil en desarrollo).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# APP_PASSWORD: si se define, el navegador pide contraseña para entrar a la app.
APP_PASSWORD=""

# MCP_KEY: clave secreta del conector de Claude (/mcp). El link para los socios es
# https://<app>/mcp?key=<MCP_KEY>. Cambiarla invalida el link anterior.
MCP_KEY=""

PORT=3000
